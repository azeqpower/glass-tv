<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf (hidden so it doesn't collide with the cards) -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp">

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:includeFontPadding="false"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:id="@+id/dateBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/shamsiDate"
                                android:gravity="left"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="#E6FFFFFF"
                                android:textSize="17sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:letterSpacing="0.02"
                                android:includeFontPadding="false"
                                android:visibility="gone" />

                            <TextClock
                                android:id="@+id/date"
                                android:gravity="left"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:format12Hour="@string/date_format"
                                android:format24Hour="@string/date_format"
                                android:textColor="#A6FFFFFF"
                                android:textSize="14sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:letterSpacing="0.14"
                                android:textAllCaps="true" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- EXACT FROSTED CARDS FROM SCREENSHOT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="2">

            <!-- Card 1: Waktu Solat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAKTU SOLAT • SELANGOR / KL"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.08" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:stretchColumns="*">

                    <TableRow>
                        <TextView android:text="Subuh" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                        <TextView android:text="Syuruk" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                        <TextView android:text="Zohor" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                        <TextView android:text="Asar" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                        <TextView android:text="Maghrib" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                        <TextView android:text="Isyak" android:textColor="#80FFFFFF" android:textSize="10sp" android:fontFamily="@font/outfit" />
                    </TableRow>

                    <TableRow android:layout_marginTop="2dp">
                        <TextView android:id="@+id/tv_subuh" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                        <TextView android:id="@+id/tv_syuruk" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                        <TextView android:id="@+id/tv_zohor" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                        <TextView android:id="@+id/tv_asar" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                        <TextView android:id="@+id/tv_maghrib" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                        <TextView android:id="@+id/tv_isyak" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/tv_solat_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="JAKIM e-Solat • SGR01"
                    android:textColor="#66FFFFFF"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Card 2: Manchester United Next Match -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• MANCHESTER UNITED • NEXT MATCH"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_match_fixture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Memuatkan perlawanan..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_match_comp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Premier League • Old Trafford"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tv_match_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Matchday Live • MYT"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500" />
            </LinearLayout>
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
